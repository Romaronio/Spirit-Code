spiritcode.duckdns.org {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    request_body {
        max_size 50MB
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle_path /static/* {
        root * /staticfiles
        file_server
    }

    # Загруженные пользователями файлы: всегда скачиваются, а не открываются
    # в браузере, и не могут выполнять скрипты на нашем домене (защита от XSS)
    handle_path /media/* {
        header Content-Disposition "attachment"
        header Content-Security-Policy "sandbox; default-src 'none'"
        root * /media
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}