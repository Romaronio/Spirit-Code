spiritcode.duckdns.org {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    request_body {
        max_size 50MB
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    # Созвоны: WebSocket-сигнализация LiveKit (видео идёт напрямую на порты 7881/7882)
    handle_path /livekit/* {
        reverse_proxy livekit:7880
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle_path /static/* {
        root * /staticfiles
        file_server
    }

    # Загруженные пользователями файлы: всегда скачиваются, а не открываются
    # в браузере, и не могут выполнять скрипты на нашем домене (защита от XSS)
    # Файл отдаётся, только если ссылка подписана сервером и не устарела
    # (проверяет Django: /api/media-auth/, см. backend/api/media.py)
    handle /media/* {
        header Content-Disposition "attachment"
        header Content-Security-Policy "sandbox; default-src 'none'"
        root * /media
        route {
            forward_auth backend:8000 {
                uri /api/media-auth/
            }
            uri strip_prefix /media
            file_server
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}